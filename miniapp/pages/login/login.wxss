.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  background: #FFFFFF;
}

/* 自动登录占位 */
.checking {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.checking-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.checking-logo-text {
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.checking-text {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.scroll {
  flex: 1;
}

/* 品牌区 - 留白为主，不使用大色块 */
.brand {
  padding: 96rpx 48rpx 56rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.logo-text {
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.brand-title {
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
  margin-bottom: 16rpx;
}
.brand-sub {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  line-height: 1.5;
}

/* 表单 */
.form {
  padding: 8rpx 48rpx 0;
}
.form-title {
  display: block;
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 32rpx;
}

.field {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: var(--color-bg);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  height: 96rpx;
  margin-bottom: 24rpx;
}
.field-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
}
.field-input {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
  height: 96rpx;
}
.ph {
  color: var(--color-text-tertiary);
  font-size: 28rpx;
}
.field-action {
  padding: 8rpx 0 8rpx 16rpx;
}
.field-action-text {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.submit-wrap {
  margin-top: 16rpx;
}

.tips {
  display: block;
  margin-top: 32rpx;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  line-height: 1.6;
}

.footer {
  padding: 32rpx 0 calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: center;
}
.footer-text {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}
