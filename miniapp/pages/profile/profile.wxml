<view class="page" style="padding-top: {{statusBarHeight}}px">

  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-left"></view>
    <text class="nav-title">我的</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view type="custom" scroll-y class="scroll-content">

    <!-- 用户卡片 -->
    <view class="user-section">
      <view class="user-card" data-type="个人资料" bindtap="onTapAction">
        <image class="user-avatar" src="/assets/icons/avatar_default.png" mode="aspectFill" />
        <view class="user-info">
          <view class="user-name-row">
            <text class="user-name">李明哲</text>
            <view class="user-role">
              <text>教师</text>
            </view>
          </view>
          <text class="user-org">计算机学院 · 软件工程系</text>
        </view>
        <view class="card-arrow"></view>
      </view>
    </view>

    <!-- 数据概览 -->
    <view class="stats-section">
      <view class="stats-card">
        <block wx:for="{{stats}}" wx:key="label">
          <view class="stats-item" data-label="{{item.label}}" bindtap="onTapAction">
            <text class="stats-value">{{item.value}}</text>
            <text class="stats-label">{{item.label}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 账号与偏好 -->
    <view class="menu-section">
      <view class="menu-card">
        <block wx:for="{{menuGroup1}}" wx:key="name">
          <view class="menu-item {{index !== menuGroup1.length - 1 ? 'menu-divider' : ''}}" data-name="{{item.name}}" bindtap="onTapMenu">
            <image class="menu-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="menu-name">{{item.name}}</text>
            <view class="menu-arrow"></view>
          </view>
        </block>
      </view>
    </view>

    <!-- 帮助与信息 -->
    <view class="menu-section">
      <view class="menu-card">
        <block wx:for="{{menuGroup2}}" wx:key="name">
          <view class="menu-item {{index !== menuGroup2.length - 1 ? 'menu-divider' : ''}}" data-name="{{item.name}}" bindtap="onTapMenu">
            <image class="menu-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="menu-name">{{item.name}}</text>
            <view class="menu-arrow"></view>
          </view>
        </block>
      </view>
    </view>

    <!-- 系统 -->
    <view class="menu-section">
      <view class="menu-card">
        <view class="menu-item" data-name="清除缓存" bindtap="onTapMenu">
          <image class="menu-icon" src="/assets/icons/profile_clear.png" mode="aspectFit" />
          <text class="menu-name">清除缓存</text>
          <text class="menu-extra">{{cacheSize}}</text>
          <view class="menu-arrow"></view>
        </view>
      </view>
    </view>

    <!-- 退出登录 -->
    <view class="logout-section">
      <view class="logout-btn" bindtap="onLogout">
        <image class="logout-icon" src="/assets/icons/profile_logout.png" mode="aspectFit" />
        <text class="logout-text">退出登录</text>
      </view>
    </view>

  </scroll-view>
</view>
