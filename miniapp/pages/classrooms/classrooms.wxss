.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

.search-row {
  padding: var(--space-sm) var(--space-md);
  background: #FFFFFF;
}

.search-input {
  height: 64rpx;
  padding: 0 var(--space-md);
  border-radius: 999rpx;
  background: var(--color-bg);
  font-size: var(--font-sm);
}

.search-placeholder {
  color: var(--color-text-tertiary);
}

.list-scroll {
  flex: 1;
  padding: var(--space-md);
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
}

.card-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--space-sm);
}

.card-head {
  flex: 1;
  min-width: 0;
}

.card-name {
  display: block;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.card-tags {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  flex-wrap: wrap;
}

.type-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.card-actions {
  display: flex;
  flex-direction: row;
  gap: var(--space-sm);
  flex-shrink: 0;
  margin-left: var(--space-sm);
}

.action-btn {
  padding: 8rpx 24rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.action-danger {
  color: #D54941;
  background: #FDECEC;
}

.action-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.card-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-xs);
}

.card-meta {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.card-capacity {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.card-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-xs);
  word-break: break-all;
}

.card-time {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.fab {
  position: fixed;
  right: var(--space-md);
  bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  box-shadow: 0 8rpx 24rpx rgba(43, 95, 246, 0.3);
  z-index: 100;
}

.fab-text {
  font-size: var(--font-md);
  color: #FFFFFF;
  font-weight: 600;
}

/* 表单字段(弹层内,与 bookings 一致) */
.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.field-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.field-input {
  height: 72rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  font-size: var(--font-md);
}

.field-textarea {
  width: auto;
  min-height: 120rpx;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  font-size: var(--font-md);
  box-sizing: border-box;
}

.field-value {
  padding: 16rpx var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  font-size: var(--font-md);
  color: var(--color-text);
}

.field-placeholder {
  color: var(--color-text-tertiary);
}
