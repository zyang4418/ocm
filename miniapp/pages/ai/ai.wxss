/* ── 页面基础 ── */
.page {
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

/* ── 导航栏 ── */
.nav-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 var(--space-md);
  background: #FFFFFF;
}

.nav-left, .nav-right {
  width: 120rpx;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

/* ── 滚动区 ── */
.scroll-content {
  flex: 1;
  padding: var(--space-md);
  box-sizing: border-box;
}

/* ── 空态引导 ── */
.hero-section {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  margin-bottom: var(--space-md);
}

.hero-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 56rpx var(--space-md);
  background: linear-gradient(135deg, #2B5FF6 0%, #5A85FF 100%);
  border-radius: var(--radius-md);
  gap: var(--space-sm);
}

.hero-icon {
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-md);
  margin-bottom: 8rpx;
}

.hero-title {
  font-size: var(--font-xl);
  font-weight: 700;
  color: #FFFFFF;
}

.hero-subtitle {
  font-size: var(--font-sm);
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  line-height: 1.6;
}

.suggest-section {
  margin-bottom: var(--space-md);
}

.section-header {
  margin-bottom: var(--space-sm);
}

.section-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text);
}

.suggest-card {
  background: #FFFFFF;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.suggest-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: var(--space-md);
}

.suggest-divider {
  border-bottom: 1rpx solid var(--color-border);
}

.suggest-text {
  flex: 1;
  font-size: var(--font-md);
  color: var(--color-text);
  line-height: 1.5;
}

/* ── 错误横幅 ── */
.error-banner {
  margin-bottom: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background: #FDECEC;
  border-radius: var(--radius-sm);
}

.error-text {
  font-size: var(--font-sm);
  color: #D54941;
}

/* ── 消息流 ── */
.msg-row {
  display: flex;
  margin-bottom: var(--space-md);
}

.msg-row--user {
  justify-content: flex-end;
}

.msg-row--assistant {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 84%;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-md);
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.msg-bubble--user {
  background: var(--color-primary);
  border-top-right-radius: var(--radius-sm);
}

.msg-bubble--assistant {
  background: #FFFFFF;
  border-top-left-radius: var(--radius-sm);
}

.msg-text {
  font-size: var(--font-md);
  line-height: 1.6;
  word-break: break-all;
  color: var(--color-text);
}

.msg-bubble--user .msg-text {
  color: #FFFFFF;
}

.msg-cursor {
  display: inline-block;
  color: var(--color-primary);
  animation: blink 1s infinite;
}

.msg-bubble--user .msg-cursor {
  color: #FFFFFF;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

.msg-loading {
  display: flex;
  flex-direction: row;
  gap: 8rpx;
  padding: 8rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-text-tertiary);
  animation: pulse 1.2s infinite;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes pulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 1; }
}

.msg-tools {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 8rpx;
}

/* ── 预约方案卡 ── */
.proposal {
  margin-top: var(--space-xs);
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.proposal-title {
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text);
}

.proposal-fields {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.proposal-field {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.proposal-conflict {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background: #FFF8E6;
}

.proposal-conflict-text {
  font-size: var(--font-xs);
  color: #B7791F;
}

.proposal-success {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background: #E0F7F0;
}

.proposal-success-text {
  font-size: var(--font-xs);
  color: #00A870;
}

.proposal-failed {
  padding: var(--space-xs) var(--space-sm);
  border-radius: var(--radius-sm);
  background: #FDECEC;
}

.proposal-failed-text {
  font-size: var(--font-xs);
  color: #D54941;
}

.proposal-actions {
  display: flex;
  flex-direction: row;
  gap: var(--space-sm);
}

.proposal-btn {
  padding: 12rpx 32rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  background: #FFFFFF;
  border: 1rpx solid var(--color-border);
}

.proposal-btn--primary {
  color: #FFFFFF;
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.proposal-btn--disabled {
  opacity: 0.5;
  pointer-events: none;
}

.proposal-dismissed {
  font-size: var(--font-sm);
  color: var(--color-text-tertiary);
}

.chat-bottom {
  height: 8rpx;
}

/* ── 底部输入框 ── */
.input-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: var(--space-sm) var(--space-md);
  background: #FFFFFF;
  border-top: 1rpx solid var(--color-border);
}

.input-wrapper {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
  height: 80rpx;
  padding: 0 var(--space-md);
  background: var(--color-bg);
  border-radius: var(--radius-lg);
}

.input {
  flex: 1;
  height: 80rpx;
  font-size: var(--font-md);
  color: var(--color-text);
}

.input-placeholder {
  color: var(--color-text-tertiary);
}

.send-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  height: 80rpx;
  background: var(--color-border);
  border-radius: 50%;
  flex-shrink: 0;
}

.send-active {
  background: var(--color-primary);
}

.send-icon {
  font-size: 28rpx;
  color: #FFFFFF;
  transform: rotate(-45deg);
  margin-left: 2rpx;
}

.send-btn--stop {
  background: #FDECEC;
}

.stop-icon {
  width: 28rpx;
  height: 28rpx;
  border-radius: 6rpx;
  background: #D54941;
}
