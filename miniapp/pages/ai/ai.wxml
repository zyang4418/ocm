<view class="page" style="padding-top: {{statusBarHeight}}px; height: {{pageHeight}}px">

  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-left"></view>
    <text class="nav-title">AI助手</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view type="custom" scroll-y class="scroll-content">

    <!-- AI 助手头部 -->
    <view class="hero-section">
      <view class="hero-card">
        <image class="hero-icon" src="/assets/icons/ai_assistant.png" mode="aspectFit" />
        <text class="hero-title">OCM AI 助手</text>
        <text class="hero-subtitle">你的智能教学搭档</text>
      </view>
    </view>

    <!-- 推荐问题 -->
    <view class="suggest-section">
      <view class="section-header">
        <text class="section-title">你可以这样问我</text>
      </view>
      <view class="suggest-card">
        <block wx:for="{{suggestions}}" wx:key="text">
          <view class="suggest-item {{index !== suggestions.length - 1 ? 'suggest-divider' : ''}}" data-text="{{item.text}}" bindtap="onTapSuggest">
            <text class="suggest-text">{{item.text}}</text>
            <view class="suggest-arrow"></view>
          </view>
        </block>
      </view>
    </view>

  </scroll-view>

  <!-- 底部输入框 -->
  <view class="input-bar" style="padding-bottom: calc(12px + {{safeAreaBottom}}px)">
    <view class="input-wrapper">
      <input
        class="input"
        placeholder="输入问题，让 AI 帮你…"
        placeholder-class="input-placeholder"
        value="{{inputValue}}"
        bindinput="onInput"
        confirm-type="send"
        bindconfirm="onSend"
      />
    </view>
    <view class="send-btn {{inputValue ? 'send-active' : ''}}" bindtap="onSend">
      <text class="send-icon">➤</text>
    </view>
  </view>

</view>
