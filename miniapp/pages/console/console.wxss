.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  /* 自定义 tabBar:100vh 已含 tabBar 区域,与内联 padding-top 一起按 border-box 计,
     否则根节点高出视口、底部内容被 tabBar 遮住 */
  box-sizing: border-box;
  background: var(--color-bg);
}

.nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  background: #FFFFFF;
}

.nav-title {
  font-size: var(--font-lg);
  font-weight: 700;
  color: var(--color-text);
}

.scroll-content {
  flex: 1;
  /* flex 子项默认 min-height:auto,内容高会撑破固定高容器,须显式清零 */
  min-height: 0;
  /* 自定义 tabBar 不再占据视口,留出 tabBar(100rpx)+安全区高度,避免末行被遮挡 */
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section {
  padding: var(--space-md) var(--space-md) 0;
}

.section-title {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-sm);
}

.section-card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  overflow: hidden;
}

.grid-container {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 33.33%;
  padding: 28rpx 0;
  box-sizing: border-box;
}

.grid-icon {
  width: 56rpx;
  height: 56rpx;
}

.grid-label {
  font-size: var(--font-xs);
  color: var(--color-text);
}
