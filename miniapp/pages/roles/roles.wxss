.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-bg);
}

.banner {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  margin: var(--space-sm) var(--space-md) 0;
  padding: var(--space-sm) var(--space-md);
  background: #FDECEC;
  border-radius: var(--radius-sm);
}

.banner-text {
  flex: 1;
  font-size: var(--font-sm);
  color: #D54941;
}

.banner-retry {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.list-scroll {
  flex: 1;
  padding: var(--space-md);
  box-sizing: border-box;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-md);
  padding: var(--space-md);
  margin-bottom: var(--space-sm);
}

.card-top {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: var(--space-xs);
}

.card-head {
  flex: 1;
  min-width: 0;
}

.card-name {
  display: block;
  font-size: var(--font-md);
  font-weight: 700;
  color: var(--color-text);
}

.card-code {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.card-tags {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
  flex-shrink: 0;
  margin-left: var(--space-sm);
}

.perm-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.sys-tag {
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: var(--font-xs);
  color: #7C5CFC;
  background: #F0EBFF;
}

.card-actions {
  display: flex;
  flex-direction: row;
  gap: var(--space-xs);
  flex-shrink: 0;
  margin-left: var(--space-sm);
}

.action-btn {
  padding: 8rpx 20rpx;
  border-radius: var(--radius-sm);
  font-size: var(--font-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.action-danger {
  color: #D54941;
  background: #FDECEC;
}

.action-disabled {
  opacity: 0.5;
  pointer-events: none;
}

.card-desc {
  display: block;
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  margin-bottom: var(--space-xs);
}

.card-time {
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
}

.fab {
  position: fixed;
  right: var(--space-md);
  bottom: calc(var(--space-lg) + env(safe-area-inset-bottom));
  padding: 20rpx 36rpx;
  border-radius: 999rpx;
  background: var(--color-primary);
  box-shadow: 0 8rpx 24rpx rgba(43, 95, 246, 0.3);
  z-index: 100;
}

.fab-text {
  font-size: var(--font-md);
  color: #FFFFFF;
  font-weight: 600;
}

.field {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
  margin-bottom: var(--space-sm);
}

.field-label {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
}

.field-input {
  height: 72rpx;
  padding: 0 var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  font-size: var(--font-md);
}

.field-input--readonly {
  color: var(--color-text-tertiary);
}

.field-textarea {
  width: auto;
  min-height: 120rpx;
  padding: var(--space-sm) var(--space-md);
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  font-size: var(--font-md);
  box-sizing: border-box;
}

.field-placeholder {
  color: var(--color-text-tertiary);
}

.perm-group {
  margin-bottom: var(--space-sm);
}

.perm-group-name {
  display: block;
  font-size: var(--font-xs);
  color: var(--color-text-tertiary);
  margin-bottom: 6rpx;
}

.perm-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: var(--space-sm);
  padding: 6rpx 0;
}

.grant-role-check {
  flex-shrink: 0;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-sm);
  border: 2rpx solid var(--color-border);
  font-size: 24rpx;
  color: #FFFFFF;
  box-sizing: border-box;
}

.checkbox-on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.perm-item-label {
  font-size: var(--font-sm);
  color: var(--color-text);
}
