<view class="page" style="padding-top: {{statusBarHeight}}px">

  <!-- 自定义导航栏 -->
  <view class="nav-bar">
    <view class="nav-left">
      <image class="nav-scan-icon" src="/assets/icons/nav_scan.png" mode="aspectFit" />
    </view>
    <text class="nav-title">首页</text>
    <view class="nav-right"></view>
  </view>

  <scroll-view type="custom" scroll-y class="scroll-content">

    <!-- 搜索栏 -->
    <view class="search-section">
      <view class="search-bar">
        <view class="search-icon">
          <view class="search-circle"></view>
          <view class="search-handle"></view>
        </view>
        <text class="search-placeholder">搜索课程 / 教室 / 学生</text>
      </view>
    </view>

    <!-- 4 顶部快入口 -->
    <view class="quick-section">
      <view class="quick-grid">
        <block wx:for="{{quickItems}}" wx:key="type">
          <view class="quick-card" data-type="{{item.type}}" data-url="{{item.url}}" data-gate="{{item.gate}}" bindtap="onTapAction">
            <image class="quick-icon-img" src="{{item.icon}}" mode="aspectFit" />
            <text class="quick-label">{{item.type}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 5x2 功能网格 -->
    <view class="grid-section">
      <view class="grid-container">
        <block wx:for="{{gridItems}}" wx:key="name">
          <view class="grid-item" data-name="{{item.name}}" data-url="{{item.url}}" data-gate="{{item.gate}}" bindtap="onTapGrid">
            <image class="grid-icon" src="{{item.icon}}" mode="aspectFit" />
            <text class="grid-label">{{item.name}}</text>
          </view>
        </block>
      </view>
    </view>

    <!-- 通知卡片 -->
    <view class="notice-section">
      <view class="notice-card">
        <view class="notice-icon-circle">
          <image class="notice-icon-img" src="/assets/icons/notice_megaphone.png" mode="aspectFit" />
        </view>
        <view class="notice-content">
          <text class="notice-title">系统通知</text>
          <text class="notice-desc">OCM v1.0 全新智慧教室管理体验已上线</text>
        </view>
        <view class="notice-arrow"></view>
      </view>
    </view>

    <!-- 产品体验卡 -->
    <view class="product-section">
      <view class="product-header">
        <text class="product-title">智能教学中心</text>
        <view class="product-more">
          <text>查看更多</text>
          <view class="more-arrow"></view>
        </view>
      </view>
      <view class="product-card">
        <view class="product-card-left">
          <image class="product-icon-img" src="/assets/icons/product_engine.png" mode="aspectFit" />
          <view class="product-card-content">
            <text class="product-card-title">智能排课引擎</text>
            <text class="product-card-desc">一键导出多维度排课方案，灵活适配教学场景</text>
          </view>
        </view>
        <view class="product-card-arrow"></view>
      </view>
    </view>

    <!-- 近期预约 -->
    <view wx:if="{{showRecent}}" class="schedule-section">
      <view class="schedule-header">
        <text class="schedule-title">近期预约</text>
        <view class="schedule-more" bindtap="onTapScheduleMore">
          <text>查看完整课表</text>
          <view class="more-arrow"></view>
        </view>
      </view>
      <view class="schedule-card">
        <block wx:for="{{recent}}" wx:key="id">
          <view class="schedule-row {{index === 0 ? 'row-first' : ''}}">
            <view class="schedule-time">
              <text class="time-start">{{item.date}}</text>
              <text class="time-end">{{item.periodText}}</text>
            </view>
            <view class="schedule-info">
              <text class="schedule-subject">{{item.purpose}}</text>
              <view class="schedule-meta">
                <text class="schedule-room">{{item.classroomName}}</text>
              </view>
            </view>
          </view>
        </block>
        <view wx:if="{{recent.length === 0}}" class="schedule-empty">暂无预约</view>
      </view>
    </view>

  </scroll-view>
</view>
