/* 复刻原生 tabBar:内容区钉死 50px(与各 tab 页 TAB_BAR_HEIGHT 常量对齐,不随屏宽
   rpx 缩放,否则宽屏上会高出预留、盖住页面底部)+ 安全区,颜色与 app.json 一致 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: row;
  height: 50px;
  box-sizing: content-box;
  background: #FFFFFF;
  padding-bottom: env(safe-area-inset-bottom);
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-bar-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-bar-label {
  font-size: 20rpx;
  line-height: 1.4;
  color: #8F959E;
}

.tab-bar-label--active {
  color: #2B5FF6;
}
