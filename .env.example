# ocm environment variables.
# Copy to .env (repo root) and adjust. docker compose auto-loads this file
# for ${VAR} interpolation. .env is gitignored -- never commit real secrets.

# --- docker compose (production: docker-compose.prod.yml) -------------
# Required by production compose. DB_PASSWORD, MYSQL_ROOT_PASSWORD, JWT_SECRET,
# ADMIN_PASSWORD, the SM2 keypair and the Web public-key pin are mandatory
# (compose fails fast if unset);
# DB_USER/DB_NAME default to "ocm".
# These same DB_USER/DB_PASSWORD/DB_NAME are also what the backend uses to
# connect, so they apply to Serverless deployments too.
MYSQL_ROOT_PASSWORD=change-me
DB_USER=ocm
DB_PASSWORD=change-me
DB_NAME=ocm

# --- Serverless / cloud runtime -------------------------------------
# The backend reads these, but docker compose injects them itself
# (DB_HOST/DB_PORT point at the bundled mysql service, PORT defaults to
# 8080), so compose ignores the values here. Set them on your Serverless
# platform to point at your cloud MySQL.
# PORT=8080
# DB_HOST=<cloud-db-host>
# DB_PORT=3306

# --- Runtime mode ---------------------------------------------------
# APP_ENV selects startup strictness. Defaults to "production", under which
# DB_HOST is required (the backend refuses a silent localhost fall-back).
# Set APP_ENV=development only for local `go run` against a localhost MySQL.
# APP_ENV=production

# --- Connection pool tuning (optional, defaults shown) ---------------
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=25
# DB_CONN_MAX_LIFETIME=5m

# --- Auth ------------------------------------------------------------
# Secret used to sign login tokens (JWT). Required in production;
# a built-in development secret is used when empty.
# JWT_SECRET=
# Initial password for the seeded "admin" account. Only applies on first
# startup when the users table is empty. Required in production (compose
# fails fast if unset); in development it defaults to "admin123".
# ADMIN_PASSWORD=

# --- SM2 Login Password Encryption -----------------------------------
# SM2 asymmetric keypair used for application-layer password encryption in transit.
# Both keys are mandatory for every backend run. Docker Compose fails fast
# when either key is missing.
# SM2_PRIVATE_KEY: 32-byte (64 hex chars) private key scalar
# SM2_PUBLIC_KEY: 64-byte (128 hex chars X||Y) or 65-byte (130 hex chars with 04 prefix) public key
# SM2_PRIVATE_KEY=
# SM2_PUBLIC_KEY=
# Pinned SHA-256 fingerprint of canonical SM2_PUBLIC_KEY. Production Web builds
# require it; use the endpoint's full 64-character value. The historical
# 16-character prefix remains accepted for compatibility.
# SM2_PUBLIC_KEY_FINGERPRINT=

# --- WeChat mini-program login -------------------------------------
# Required for the mini-program bind / silent-login flow. The backend uses
# them to call WeChat's code2Session API (jscode2session) to resolve the
# caller's openid -- the openid is NOT trusted from the cloud-gateway
# X-WX-OPENID header, since the backend is also public for the web console.
# Leave empty for a web-only deployment (the wx-bind/wx-login endpoints will
# refuse with 502 until configured).
# WX_APP_ID=
# WX_APP_SECRET=

# --- Site ------------------------------------------------------------
# ICP filing number shown at the bottom of the login page (linked to
# beian.miit.gov.cn). Leave empty to keep the page unchanged. It is a
# frontend build-time value: dev picks it up on `docker compose up -d web`;
# production bakes it into the bundle, so rebuild the web image to change it.
# ICP_NUMBER=京ICP备12345678号-1
# External docs site origin (e.g. https://docs.example.com). When set, the
# login-page "Docs" link and the import-page docs link are shown; when empty
# they are hidden. Same build-time handling as ICP_NUMBER.
# DOCS_URL=https://docs.example.com
