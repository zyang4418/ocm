{
  "annotations": { "list": [] },
  "editable": true,
  "uid": "ocm-overview",
  "title": "OCM 服务状态总览",
  "description": "给运维人员的服务状态面板：服务健康、请求 RED 指标、主机资源、DB 连接池与最近错误日志。错误反馈流程：点开日志面板复制 request_id，连同时间一并反馈给开发，即可精确定位该次请求。",
  "tags": ["ocm"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "服务在线",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": { "text": "在线", "color": "green", "index": 0 },
                "0": { "text": "离线", "color": "red", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "up{job=\"ocm-backend\"}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "请求速率",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 4, "w": 9, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total[5m]))", "legendFormat": "req/s" }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx 错误速率",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 4, "w": 9, "x": 15, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m]))", "legendFormat": "5xx/s" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 请求延迟",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "进行中请求",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "refId": "A", "expr": "http_requests_in_flight", "legendFormat": "in-flight" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU 占用率",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "整机"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "内存占用率",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "整机"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "磁盘占用率",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": {
        "defaults": { "unit": "percent", "max": 100, "min": 0 },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay|squashfs\"})",
          "legendFormat": "{{mountpoint}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "DB 连接池",
      "datasource": { "type": "prometheus", "uid": "ocm-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        { "refId": "A", "expr": "ocm_db_connections_in_use", "legendFormat": "使用中" },
        { "refId": "B", "expr": "ocm_db_connections_open", "legendFormat": "已打开" },
        { "refId": "C", "expr": "ocm_db_wait_count_total", "legendFormat": "累计等待次数" }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "最近后端错误日志",
      "description": "反馈错误时请复制日志行里的 request_id 连同时间一并发给开发，可精确定位该次请求。",
      "datasource": { "type": "loki", "uid": "ocm-loki" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        { "refId": "A", "expr": "{container=~\".*backend.*\"} | json | level = `ERROR`" }
      ]
    }
  ]
}
