{
    "swagger": "2.0",
    "info": {
        "description": "Classroom management backend (Go net/http ServeMux). Auth via JWT Bearer (HS256, 24h); mini-program identity resolved server-side via code2Session.",
        "title": "OCM 智慧教室管理平台 API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/checkins": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "List checkins",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "filter by course offering id",
                        "name": "offering_id",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "filter by schedule session id",
                        "name": "session_id",
                        "in": "query"
                    },
                    {
                        "enum": [
                            "active",
                            "closed"
                        ],
                        "type": "string",
                        "description": "checkin status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "inclusive start YYYY-MM-DD",
                        "name": "from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "inclusive end YYYY-MM-DD",
                        "name": "to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "search by title",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "1-based page",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 100,
                        "description": "page size",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "paged checkins",
                        "schema": {
                            "$ref": "#/definitions/httpx.Paged"
                        }
                    },
                    "400": {
                        "description": "invalid status filter",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "Create a checkin",
                "parameters": [
                    {
                        "description": "checkin input",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/attendance.CheckinInput"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "created checkin",
                        "schema": {
                            "$ref": "#/definitions/attendance.CheckinView"
                        }
                    },
                    "400": {
                        "description": "invalid body / title required / session not in offering",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "offering or session not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "internal error",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/checkins/export": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "Export offering attendance report as xlsx",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "course offering id",
                        "name": "offering_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "xlsx download",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "offering_id required",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "offering not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/checkins/me": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "List the caller's own checkins",
                "parameters": [
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "1-based page",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 100,
                        "description": "page size",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "paged my checkins",
                        "schema": {
                            "$ref": "#/definitions/httpx.Paged"
                        }
                    }
                }
            }
        },
        "/api/checkins/scan": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "Scan to check in",
                "parameters": [
                    {
                        "description": "6-digit scan code",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/attendance.ScanRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "scan result",
                        "schema": {
                            "$ref": "#/definitions/attendance.ScanResult"
                        }
                    },
                    "400": {
                        "description": "invalid code",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "code not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "closed or expired",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/checkins/summary": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "L2 semester attendance summary",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "course offering id",
                        "name": "offering_id",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "summary",
                        "schema": {
                            "$ref": "#/definitions/attendance.OfferingSummary"
                        }
                    },
                    "400": {
                        "description": "offering_id required",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "offering not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/checkins/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "Get a checkin",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "checkin id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "checkin detail",
                        "schema": {
                            "$ref": "#/definitions/attendance.CheckinView"
                        }
                    },
                    "400": {
                        "description": "invalid id",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/checkins/{id}/close": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "Close a checkin",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "checkin id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "204": {
                        "description": "closed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "400": {
                        "description": "invalid id",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "409": {
                        "description": "already closed",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/checkins/{id}/export": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "Export a checkin's records as xlsx",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "checkin id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "xlsx download",
                        "schema": {
                            "type": "file"
                        }
                    },
                    "400": {
                        "description": "invalid id",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/checkins/{id}/records": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "List a checkin's records",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "checkin id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "enum": [
                            "present",
                            "late",
                            "absent",
                            "leave"
                        ],
                        "type": "string",
                        "description": "record status",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "search by student name/no",
                        "name": "q",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 1,
                        "description": "1-based page",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "default": 100,
                        "description": "page size",
                        "name": "page_size",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "paged records",
                        "schema": {
                            "$ref": "#/definitions/httpx.Paged"
                        }
                    },
                    "400": {
                        "description": "invalid id/status",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "checkin not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/checkins/{id}/records/{userId}": {
            "put": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "attendance"
                ],
                "summary": "Correct a student's record",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "checkin id",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "student user id",
                        "name": "userId",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "new status",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/attendance.RecordUpdateInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "updated record",
                        "schema": {
                            "$ref": "#/definitions/attendance.CheckinRecordView"
                        }
                    },
                    "400": {
                        "description": "invalid id/status",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "checkin/student not found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "attendance.CheckinInput": {
            "type": "object",
            "properties": {
                "durationMinute": {
                    "type": "integer"
                },
                "lateMinutes": {
                    "type": "integer"
                },
                "offeringId": {
                    "type": "integer"
                },
                "sessionId": {
                    "type": "integer"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "attendance.CheckinRecordView": {
            "type": "object",
            "properties": {
                "adminClass": {
                    "description": "\"grade name\", \"\" when unknown",
                    "type": "string"
                },
                "checkedAt": {
                    "type": "string"
                },
                "checkinId": {
                    "type": "integer"
                },
                "displayName": {
                    "type": "string"
                },
                "inRoster": {
                    "type": "boolean"
                },
                "modifiedAt": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "studentNo": {
                    "type": "string"
                },
                "userId": {
                    "type": "integer"
                }
            }
        },
        "attendance.CheckinView": {
            "type": "object",
            "properties": {
                "closedAt": {
                    "type": "string"
                },
                "code": {
                    "type": "string"
                },
                "counts": {
                    "$ref": "#/definitions/attendance.Counts"
                },
                "courseName": {
                    "type": "string"
                },
                "createdAt": {
                    "type": "string"
                },
                "createdBy": {
                    "type": "integer"
                },
                "expiresAt": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "lateMinutes": {
                    "type": "integer"
                },
                "offeringId": {
                    "type": "integer"
                },
                "semester": {
                    "type": "string"
                },
                "sessionId": {
                    "type": "integer"
                },
                "sessionText": {
                    "type": "string"
                },
                "startsAt": {
                    "type": "string"
                },
                "status": {
                    "description": "active | closed",
                    "type": "string"
                },
                "teacher": {
                    "type": "string"
                },
                "teachingClassName": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "attendance.Counts": {
            "type": "object",
            "properties": {
                "absent": {
                    "type": "integer"
                },
                "expected": {
                    "type": "integer"
                },
                "late": {
                    "type": "integer"
                },
                "leave": {
                    "type": "integer"
                },
                "present": {
                    "type": "integer"
                }
            }
        },
        "attendance.OfferingSummary": {
            "type": "object",
            "properties": {
                "checkins": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/attendance.CheckinView"
                    }
                },
                "courseName": {
                    "type": "string"
                },
                "offeringId": {
                    "type": "integer"
                },
                "rows": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/attendance.SummaryRow"
                    }
                },
                "semester": {
                    "type": "string"
                },
                "teacher": {
                    "type": "string"
                },
                "teachingClassName": {
                    "type": "string"
                }
            }
        },
        "attendance.RecordUpdateInput": {
            "type": "object",
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "present",
                        "late",
                        "absent",
                        "leave"
                    ],
                    "example": "present"
                }
            }
        },
        "attendance.ScanRequest": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "123456"
                }
            }
        },
        "attendance.ScanResult": {
            "type": "object",
            "properties": {
                "checkinId": {
                    "type": "integer"
                },
                "inRoster": {
                    "type": "boolean"
                },
                "isNew": {
                    "type": "boolean"
                },
                "status": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            }
        },
        "attendance.SummaryRow": {
            "type": "object",
            "properties": {
                "adminClass": {
                    "type": "string"
                },
                "displayName": {
                    "type": "string"
                },
                "inRoster": {
                    "type": "boolean"
                },
                "records": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "studentNo": {
                    "type": "string"
                },
                "totals": {
                    "type": "object",
                    "additionalProperties": {
                        "type": "integer"
                    }
                },
                "userId": {
                    "type": "integer"
                }
            }
        },
        "httpx.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "invalid request body"
                }
            }
        },
        "httpx.Paged": {
            "type": "object",
            "properties": {
                "items": {},
                "page": {
                    "type": "integer"
                },
                "pageSize": {
                    "type": "integer"
                },
                "total": {
                    "type": "integer"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "\"JWT Bearer token; prefix with 'Bearer '.\"",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}