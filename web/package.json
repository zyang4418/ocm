{
  "name": "ocm-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "gen:types": "swagger2openapi ../backend/docs/swagger.json -o .openapi.json && openapi-typescript .openapi.json -o src/types/api.d.ts"
  },
  "dependencies": {
    "@carbon/ai-chat": "^1.18.0",
    "@carbon/charts-react": "^1.27.18",
    "@carbon/icons-react": "^11.84.0",
    "@carbon/react": "^1.112.0",
    "@carbon/web-components": "^2.61.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sm-crypto": "^0.5.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitejs/plugin-react": "^6.0.2",
    "openapi-typescript": "^7.13.0",
    "sass": "^1.102.0",
    "swagger2openapi": "^7.0.8",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  },
  "overrides": {
    "postcss": ">=8.5.18",
    "nanoid": ">=3.3.17 <4"
  }
}
